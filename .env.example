# OpenForce CRM Environment Configuration

PORT=3000
NODE_ENV=development

# Database path (SQLite file location)
DATABASE_PATH=./openforce.db

# JWT secret key for cryptographic sessions (MUST be at least 32 characters in production)
JWT_SECRET=replace_with_at_least_32_characters_random_secret_in_production

# Demo seeding: set to 'true' ONLY in local evaluation/development environments.
# In production, leave as 'false' so known demo accounts are not created.
AUTO_SEED=false
